# Web — Environment Configuration
# Copy to .env.local (git-ignored) and adjust if needed.

# API base used by the browser.
# Keep "/api" when the web app and API share a domain through a reverse proxy.
# VITE_API_URL=http://127.0.0.1:8000/api
VITE_API_URL=/api

# Backend address used by the Vite dev-server proxy.
# Must be reachable from the process/container running Vite.
# VITE_* variables are also exposed to the browser, so never put secrets here.
# Examples:
#   local dev:            http://127.0.0.1:8000
#   docker compose:       http://backend:8000
#   docker on the host:   http://host.docker.internal:8000
#   backend on Tailscale: http://100.x.y.z:8000
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
